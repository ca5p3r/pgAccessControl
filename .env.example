# Copy to .env and adjust. Docker Compose reads .env automatically; for local (non-Docker) runs the
# backend also reads backend/.env.
#
# IMPORTANT: keep comments on their own lines. Docker Compose treats text after an empty value
# ("KEY=   # note") as the value itself, which breaks the app at startup.

# ---------------------------------------------------------------------------
# PostgreSQL server to administer
# The account needs SUPERUSER (recommended), or at least CREATEROLE plus admin rights on the roles
# and objects you want to manage.
# ---------------------------------------------------------------------------
# Service name of the demo db, a hostname, or host.docker.internal
PG_HOST=db
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
# Maintenance database for cluster-wide queries (roles, database list)
PG_DATABASE=postgres
# disable | allow | prefer | require | verify-ca | verify-full
PG_SSLMODE=prefer

# How this server is shown in the console's server switcher
PG_SERVER_NAME=Default server
# production | staging | development | other. Production gets a red banner and extra confirmation before changes
PG_ENVIRONMENT=other
# true = nobody can change anything on this server through the console
PG_READ_ONLY=false

# ---------------------------------------------------------------------------
# Managing several servers. The server above is always available as "Default server"; admins can add more
# in the UI (Servers page).
# ---------------------------------------------------------------------------
# Encrypts the passwords of servers added in the UI (AES-256-GCM). Use a long random string and keep it safe:
# without it those passwords cannot be decrypted. Generate with: openssl rand -hex 32
# If unset, an explicitly set SECRET_KEY is used instead (not recommended: rotating it would lock you out).
ENCRYPTION_KEY=
# Rotation: put the old key here and the new one above; saved passwords are re-encrypted at startup
ENCRYPTION_KEY_PREVIOUS=
# false = no adding or changing servers in the UI
SERVER_MANAGEMENT_ENABLED=true
# Restrict which hosts can be added: comma separated host names, *.suffix patterns or CIDR ranges. Empty = any host
SERVER_HOST_ALLOWLIST=
MAX_SERVER_PROFILES=50
# Servers with open connection pools at once; the least recently used idle ones are closed
MAX_OPEN_SERVERS=16

# ---------------------------------------------------------------------------
# Connection pooling. One small pool is opened per database you inspect; the least recently used
# pools are closed once POOL_MAX_DATABASES is exceeded.
# ---------------------------------------------------------------------------
POOL_MIN_SIZE=1
POOL_MAX_SIZE=5
POOL_MAX_DATABASES=8

# ---------------------------------------------------------------------------
# Login for the web UI (this is NOT a PostgreSQL account)
# ---------------------------------------------------------------------------
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
# Signs session cookies; required with Docker. Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-a-long-random-string
SESSION_TTL_MINUTES=480
# Set to true when served over HTTPS (e.g. behind a TLS proxy)
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Who may use this console. The built-in admin above always works (break-glass); more people can be
# added as accounts in the UI (viewer / operator / admin) and/or sign in through SSO.
# ---------------------------------------------------------------------------
# false = SSO only (needs the OIDC_* settings below)
LOCAL_LOGIN_ENABLED=true

# Single sign-on with any OpenID Connect provider (Keycloak, Entra ID, Okta, Google, Authentik, ...).
# Register this app as a client with redirect URI  https://<your-host>/api/auth/oidc/callback
# SSO is enabled when OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_CLIENT_SECRET are all set; leave them empty to disable.
# Example issuer: https://login.example.com/realms/corp (must serve /.well-known/openid-configuration)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Set this when running behind a proxy; by default it is derived from the request
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_USERNAME_CLAIM=preferred_username
# The ID token claim that lists the user's groups
OIDC_GROUPS_CLAIM=groups
# Comma separated group names per role; the highest matching role wins
OIDC_ADMIN_GROUPS=
OIDC_OPERATOR_GROUPS=
OIDC_VIEWER_GROUPS=
# Role for users who are in none of the groups: viewer, operator or admin. Empty = refuse them
OIDC_DEFAULT_ROLE=
OIDC_BUTTON_LABEL=Sign in with SSO

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
# How often temporary access is checked for expiry
SCHEDULER_INTERVAL_SECONDS=30
# Greater than 0: compare "baseline" snapshots with the live server this often (minutes). 0 = off
DRIFT_CHECK_INTERVAL_MINUTES=0
# Accounts, schedules and snapshots; local runs only (Docker uses /data/app.db)
# DATA_DB_PATH=data/app.db

# ---------------------------------------------------------------------------
# Audit history: who changed what, stored in a SQLite file (Docker: the ./data folder next to docker-compose.yml, mounted at /data).
# Entries are also written as JSON lines to the "pgac.audit" log for collectors such as Loki/ELK.
# ---------------------------------------------------------------------------
AUDIT_ENABLED=true
# Older entries are deleted daily; 0 keeps everything
AUDIT_RETENTION_DAYS=365
# Local runs only; the Docker image uses /data/audit.db
# AUDIT_DB_PATH=data/audit.db

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Host port published by docker compose
APP_PORT=8000
WORKERS=1
LOG_LEVEL=info
