# Copy to .env and adjust. Docker Compose reads .env automatically; for local (non-Docker) runs the
# backend also reads backend/.env.

# ---------------------------------------------------------------------------
# PostgreSQL server to administer
# The account needs SUPERUSER (recommended), or at least CREATEROLE plus admin rights on the roles
# and objects you want to manage.
# ---------------------------------------------------------------------------
PG_HOST=db                  # service name of the demo db, a hostname, or host.docker.internal
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DATABASE=postgres        # maintenance database for cluster-wide queries (roles, database list)
PG_SSLMODE=prefer           # disable | allow | prefer | require | verify-ca | verify-full

# ---------------------------------------------------------------------------
# Connection pooling. One small pool is opened per database you inspect; the least recently used
# pools are closed once POOL_MAX_DATABASES is exceeded.
# ---------------------------------------------------------------------------
POOL_MIN_SIZE=1
POOL_MAX_SIZE=5
POOL_MAX_DATABASES=8

# ---------------------------------------------------------------------------
# Login for the web UI (this is NOT a PostgreSQL account)
# ---------------------------------------------------------------------------
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
SECRET_KEY=replace-with-output-of-openssl-rand-hex-32   # signs session cookies; required with Docker
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false         # set to true when served over HTTPS (e.g. behind a TLS proxy)

# ---------------------------------------------------------------------------
# Who may use this console. The built-in admin above always works (break-glass); more people can be
# added as accounts in the UI (viewer / operator / admin) and/or sign in through SSO.
# ---------------------------------------------------------------------------
LOCAL_LOGIN_ENABLED=true    # false = SSO only (needs the OIDC_* settings below)

# Single sign-on with any OpenID Connect provider (Keycloak, Entra ID, Okta, Google, Authentik, ...).
# Register this app as a client with redirect URI  https://<your-host>/api/auth/oidc/callback
OIDC_ISSUER=                # e.g. https://login.example.com/realms/corp  (must serve /.well-known/openid-configuration)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=          # set this when running behind a proxy; default is derived from the request
OIDC_SCOPES=openid email profile
OIDC_USERNAME_CLAIM=preferred_username
OIDC_GROUPS_CLAIM=groups    # the ID token claim that lists the user's groups
OIDC_ADMIN_GROUPS=          # comma separated group names; the highest matching role wins
OIDC_OPERATOR_GROUPS=
OIDC_VIEWER_GROUPS=
OIDC_DEFAULT_ROLE=          # role for users in none of the groups; empty = refuse them
OIDC_BUTTON_LABEL=Sign in with SSO

# ---------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------
SCHEDULER_INTERVAL_SECONDS=30     # how often temporary access is checked for expiry
DRIFT_CHECK_INTERVAL_MINUTES=0    # >0: compare "baseline" snapshots with the live server this often; 0 = off
# DATA_DB_PATH=data/app.db        # accounts, schedules, snapshots; local runs only (Docker: /data/app.db)

# ---------------------------------------------------------------------------
# Audit history: who changed what, stored in a SQLite file (Docker: the appdata volume at /data).
# Entries are also written as JSON lines to the "pgac.audit" log for collectors such as Loki/ELK.
# ---------------------------------------------------------------------------
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=365    # older entries are deleted daily; 0 keeps everything
# AUDIT_DB_PATH=data/audit.db   # local runs only; the Docker image uses /data/audit.db

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
APP_PORT=8000               # host port published by docker compose
WORKERS=1
LOG_LEVEL=info
